{
  "$ref": "#/definitions/RentalTermFile",
  "definitions": {
    "RentalTermFile": {
      "type": "object",
      "properties": {
        "rental_term": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["long", "short"]
            },
            "exclude_unknown": {
              "type": "boolean",
              "default": false
            },
            "stay": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date-time"
                },
                "to": {
                  "type": "string",
                  "format": "date-time"
                },
                "min_months": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_months": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      },
      "required": ["rental_term"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
